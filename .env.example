# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# UUID строки `users` в Supabase — общий для всех браузеров и мобильных (рекомендуется для Vercel).
# Серверный вариант не попадает в клиентский бандл; для локалки можно по-прежнему использовать NEXT_PUBLIC_*.
WORKOUT_USER_ID=
# Опционально: то же значение в клиенте (избегай дубля с WORKOUT_USER_ID на проде)
NEXT_PUBLIC_WORKOUT_USER_ID=
# Для npm run seed:supabase — тот же UUID, что в браузере (или NEXT_PUBLIC_WORKOUT_USER_ID)
WORKOUT_IMPORT_USER_ID=
# Для npm run seed:expenses — тот же UUID, fallback на WORKOUT_IMPORT_USER_ID / NEXT_PUBLIC_WORKOUT_USER_ID
EXPENSES_IMPORT_USER_ID=
# Абсолютный путь к экспорту Money Manager (.xls — это HTML). Если не задан, ищем
# docs/features/expenses/current_stat/Money Manager_*.xls, потом C:/Users/Ababikov/Downloads/.
EXPENSES_MM_FILE=

# Huawei Health Kit (OAuth + REST import)
# HUAWEI_HEALTH_CLIENT_ID=
# HUAWEI_HEALTH_CLIENT_SECRET=
# HUAWEI_HEALTH_REDIRECT_URI=https://personal-agent-zeta.vercel.app/api/integrations/huawei/callback
# Опционально: доп. scope через пробел (только одобренные в консоли Huawei)
# HUAWEI_HEALTH_SCOPES=https://www.huawei.com/healthkit/activityrecord.read https://www.huawei.com/healthkit/historydata.open.year
# HUAWEI_OAUTH_STATE_SECRET=  # fallback: SITE_AUTH_SECRET

# Google Sheets (OAuth в приложении — отдельно от бэкапа)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Бэкап Supabase → Google Таблица (npm run backup:sheets, backup:all).
# Снимок читается с той БД, что в NEXT_PUBLIC_SUPABASE_URL (облако / self-hosted — разный .env или второй job).
# ID таблицы из URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SHEETS_BACKUP_SPREADSHEET_ID=

# Excel: npm run backup:excel или backup:all (папка по умолчанию ./backups/excel)
# BACKUP_EXCEL_DIR=
# BACKUP_EXCEL_FILENAME=latest-backup.xlsx

# Второй проект Supabase — полная перезапись таблиц из снимка (только выделенный пустой проект!)
# SUPABASE_MIRROR_URL=https://other.supabase.co
# SUPABASE_MIRROR_SERVICE_ROLE_KEY=
# Ключ: либо весь JSON одной строкой (удобно на Vercel / в CI), приоритет над файлом:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...",...}
# либо путь к скачанному .json (локально):
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
# GOOGLE_APPLICATION_CREDENTIALS=

# Supabase service role — для бэкапа при строгих RLS (в Dashboard → Settings → API)
# SUPABASE_SERVICE_ROLE_KEY=

# BACKUP_INCLUDE_EMBEDDINGS=1

# OpenRouter (LLM + Embeddings)
OPENROUTER_API_KEY=your-openrouter-key
# Optional overrides — по умолчанию anthropic/claude-sonnet-4 и openai/text-embedding-3-large
# OPENROUTER_LLM_MODEL=anthropic/claude-sonnet-4
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-large
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Лимит выходных токенов на один запрос агента (дефолт 4096, чтобы ответы не обрезались;
# при малом балансе/402 уменьшите, напр. 1024 или 512). Clamp 64..8192.
# OPENROUTER_MAX_COMPLETION_TOKENS=4096
# Температура агента (дефолт 0.4 — живее для коуч-диалога, но детерминирована для расчётов). Clamp 0..2.
# OPENROUTER_TEMPERATURE=0.4
# Своя цепочка фоллбеков через запятую (иначе встроенные gpt-4o-mini, gemini-2.0-flash, deepseek-chat)
# OPENROUTER_LLM_FALLBACKS=openai/gpt-4o-mini,google/gemini-2.0-flash-001

# Tavily — веб-поиск для агента (тул web_search). Без ключа тул вернёт подсказку «не настроен».
# TAVILY_API_KEY=tvly-...

# Простая защита всего веб-приложения одним паролем (cookie с подписью).
# Если не заданы оба — вход не требуется (удобно для локальной разработки).
# SITE_PASSWORD=...
# SITE_AUTH_SECRET=случайная-длинная-строка-для-подписи-cookie
