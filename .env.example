# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional: UUID строки `users` из Supabase (если не задашь — создастся пустой user при первом «Сохранить»)
NEXT_PUBLIC_WORKOUT_USER_ID=
# Для npm run seed:supabase — тот же UUID, что в браузере (или NEXT_PUBLIC_WORKOUT_USER_ID)
WORKOUT_IMPORT_USER_ID=

# Google Sheets
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OpenRouter (LLM + Embeddings)
OPENROUTER_API_KEY=your-openrouter-key
