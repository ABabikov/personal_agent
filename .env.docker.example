# Скопируй в .env.docker и подставь значения. Используется docker compose для сервиса web.
# Для build нужны те же NEXT_PUBLIC_* (передаются как build-args из этого файла через compose).

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Опционально, как в основном .env
# NEXT_PUBLIC_WORKOUT_USER_ID=
# WORKOUT_USER_ID=

# SITE_PASSWORD=...
# SITE_AUTH_SECRET=...

OPENROUTER_API_KEY=

# Порт на хосте
WEB_PORT=3000
