# Скопируй в .env.docker — для docker compose на своём сервере.
# Сборка: NEXT_PUBLIC_* передаются как build-args (нужен rebuild при смене URL Supabase).
# Runtime: остальные переменные читаются при старте контейнера.

# --- Supabase (облако или self-hosted API URL) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=

# Один пользователь инстанса (как WORKOUT_USER_ID в основном .env)
WORKOUT_USER_ID=
NEXT_PUBLIC_WORKOUT_USER_ID=

# --- Доступ к сайту ---
SITE_PASSWORD=
SITE_AUTH_SECRET=

# --- OpenRouter (чат-агент) ---
OPENROUTER_API_KEY=

# --- Huawei Health Kit ---
HUAWEI_HEALTH_CLIENT_ID=
HUAWEI_HEALTH_CLIENT_SECRET=
# Домен вашего сервера или Vercel:
HUAWEI_HEALTH_REDIRECT_URI=https://your-domain.example.com/api/integrations/huawei/callback
# HUAWEI_HEALTH_SCOPES=https://www.huawei.com/healthkit/activityrecord.read https://www.huawei.com/healthkit/historydata.open.year
# HUAWEI_OAUTH_STATE_SECRET=

# Порт на хосте (внутри контейнера всегда 3000)
WEB_PORT=3000
